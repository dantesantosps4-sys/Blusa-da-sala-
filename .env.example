# Supabase (Settings -> API no painel)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave do painel admin. Precisa ser IGUAL ao app_config.admin_key no banco.
# Deixe vazio para desligar a trava do admin (não recomendado).
VITE_ADMIN_KEY=troque-esta-chave-do-admin
